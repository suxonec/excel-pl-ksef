  "source": "open-api.json + verified live on TEST 2026-10-24 (docs/api-notes.md)",
  "notes": [
    "The real response lists every group. One collectiveIdentifier budget covers generate, decode, lookup and query together."
  ],
  "request": {
    "method": "GET",
