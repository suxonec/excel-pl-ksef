{
  "scenario": "Redeem the access and refresh tokens (one-time).",
  "source": "open-api.json + verified live on TEST 2026-10-24 (docs/api-notes.md)",
  "request": {
    "method": "POST",
    "url": "https://api-test.ksef.mf.gov.pl/v2/auth/token/redeem",
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <authenticationToken>",
      "X-Error-Format": "problem-details"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "accessToken": {
        "token": "<accessToken>",
        "validUntil": "2026-10-27T09:30:01+00:00"
      },
      "refreshToken": {
        "token": "<refreshToken>",
        "validUntil": "2026-11-03T09:15:01+00:00"
      }
    }
  }
}
